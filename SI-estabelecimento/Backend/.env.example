# Banco de dados (PostgreSQL / Supabase)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres"

# Telegram Bot API (envio de notificações e botões de resposta)
TELEGRAM_BOT_TOKEN="SEU_TOKEN_DO_BOTFATHER"
TELEGRAM_CHAT_ID="SEU_CHAT_ID"

# Modo de recebimento das respostas do cliente:
# - polling (padrão): funciona localmente, sem URL pública. Desative com "false".
# - webhook: em produção, registre a URL pública via POST /api/telegram/set-webhook
TELEGRAM_USE_POLLING="true"

# Opcional: valida o cabeçalho X-Telegram-Bot-Api-Secret-Token no webhook.
TELEGRAM_WEBHOOK_SECRET="UM_SEGREDO_QUALQUER"
